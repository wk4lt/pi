#!/usr/bin/env bash
# Run the installed CLI without automatic public network operations.
set -euo pipefail

launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
install_root=$(dirname -- "$(dirname -- "$launcher")")
export PI_OFFLINE=1
exec "$install_root/runtime/bin/node" "$install_root/app/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js" "$@"
